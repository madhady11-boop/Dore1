rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bkwrya552@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function hasRole(role) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
      );
    }

    function isTeamManager(teamId) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == teamId
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && data.role in ["super_admin", "tournament_manager", "disciplinary_committee", "media_manager", "stats_manager", "team"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 50));
    }

    match /users/{userId} {
      allow read: if true; // Public for stats/names or could be restricted
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time && (incoming().role == 'team' || isAdmin()); // Anyone can create a team account, or only admins? Let's say admins create them. So:
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && (isAdmin() || (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])));
      allow delete: if isAdmin();
      allow list: if true;
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 500)) &&
             (!('coach' in data) || (data.coach is string && data.coach.size() <= 100)) &&
             (!('captain' in data) || (data.captain is string && data.captain.size() <= 100)) &&
             (!('establishedYear' in data) || data.establishedYear is number) &&
             (!('played' in data) || data.played is number) &&
             (!('won' in data) || data.won is number) &&
             (!('drew' in data) || data.drew is number) &&
             (!('lost' in data) || data.lost is number) &&
             (!('goalsFor' in data) || data.goalsFor is number) &&
             (!('goalsAgainst' in data) || data.goalsAgainst is number) &&
             (!('points' in data) || data.points is number);
    }

    match /teams/{teamId} {
      allow read, list: if true;
      allow create: if hasRole('tournament_manager') && isValidId(teamId) && isValidTeam(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(teamId) && isValidTeam(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && (hasRole('tournament_manager') || (isTeamManager(teamId) && incoming().diff(existing()).affectedKeys().hasOnly(['logo', 'coach', 'captain', 'establishedYear', 'updatedAt'])));
      allow delete: if hasRole('tournament_manager');
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['teamId', 'name', 'status', 'createdAt', 'updatedAt']) &&
             data.teamId is string && data.teamId.size() <= 50 &&
             data.name is string && data.name.size() <= 100 &&
             data.status is string && data.status in ["active", "suspended", "excluded", "unregistered"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('photo' in data) || (data.photo is string && data.photo.size() <= 500)) &&
             (!('number' in data) || data.number is number) &&
             (!('birthYear' in data) || data.birthYear is number) &&
             (!('position' in data) || (data.position is string && data.position.size() <= 50)) &&
             (!('goals' in data) || data.goals is number) &&
             (!('yellowCards' in data) || data.yellowCards is number) &&
             (!('redCards' in data) || data.redCards is number) &&
             (!('matchesPlayed' in data) || data.matchesPlayed is number) &&
             (!('motm' in data) || data.motm is number);
    }

    match /players/{playerId} {
      allow read, list: if true;
      allow create: if isValidId(playerId) && isValidPlayer(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time && exists(/databases/$(database)/documents/teams/$(incoming().teamId)) && (hasRole('tournament_manager') || isTeamManager(incoming().teamId));
      allow update: if isValidId(playerId) && isValidPlayer(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().teamId == existing().teamId && (hasRole('tournament_manager') || hasRole('stats_manager') || isTeamManager(existing().teamId));
      allow delete: if hasRole('tournament_manager') || isTeamManager(existing().teamId);
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['homeTeamId', 'awayTeamId', 'status', 'createdAt', 'updatedAt']) &&
             data.homeTeamId is string && data.homeTeamId.size() <= 50 &&
             data.awayTeamId is string && data.awayTeamId.size() <= 50 &&
             data.status is string && data.status in ["upcoming", "finished", "postponed", "cancelled"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('time' in data) || (data.time is string && data.time.size() <= 50)) &&
             (!('stadiumId' in data) || (data.stadiumId is string && data.stadiumId.size() <= 50)) &&
             (!('round' in data) || (data.round is string && data.round.size() <= 50)) &&
             (!('homeScore' in data) || data.homeScore is number) &&
             (!('awayScore' in data) || data.awayScore is number) &&
             (!('refereeId' in data) || (data.refereeId is string && data.refereeId.size() <= 50)) &&
             (!('report' in data) || (data.report is string && data.report.size() <= 5000));
    }

    match /matches/{matchId} {
      allow read, list: if true;
      allow create: if hasRole('tournament_manager') && isValidId(matchId) && isValidMatch(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(matchId) && isValidMatch(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && (hasRole('tournament_manager') || hasRole('stats_manager'));
      allow delete: if hasRole('tournament_manager');
    }

    function isValidMatchEvent(data) {
      return data.keys().hasAll(['matchId', 'teamId', 'playerId', 'type', 'minute', 'createdAt']) &&
             data.matchId is string && data.matchId.size() <= 50 &&
             data.teamId is string && data.teamId.size() <= 50 &&
             data.playerId is string && data.playerId.size() <= 50 &&
             data.type is string && data.type in ["goal", "yellow_card", "red_card", "sub_in", "sub_out", "motm"] &&
             data.minute is number &&
             data.createdAt is timestamp;
    }

    match /matchEvents/{eventId} {
      allow read, list: if true;
      allow create: if (hasRole('tournament_manager') || hasRole('stats_manager')) && isValidId(eventId) && isValidMatchEvent(incoming()) && incoming().createdAt == request.time;
      allow update: if false; // events are immutable, delete and recreate if needed
      allow delete: if (hasRole('tournament_manager') || hasRole('stats_manager'));
    }

    function isValidDisciplinaryDecision(data) {
      return data.keys().hasAll(['targetType', 'status', 'createdAt', 'updatedAt']) &&
             data.targetType is string && data.targetType in ["player", "coach", "team", "fans"] &&
             data.status is string && data.status in ["published", "draft"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('number' in data) || (data.number is string && data.number.size() <= 50)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 50)) &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 1000)) &&
             (!('penaltyType' in data) || (data.penaltyType is string && data.penaltyType.size() <= 100)) &&
             (!('amount' in data) || data.amount is number) &&
             (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 50));
    }

    match /disciplinaryDecisions/{decisionId} {
      allow read, list: if existing().status == 'published' || hasRole('disciplinary_committee') || isTeamManager(existing().targetId); // assuming targetId might be teamId
      allow create: if hasRole('disciplinary_committee') && isValidId(decisionId) && isValidDisciplinaryDecision(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if hasRole('disciplinary_committee') && isValidId(decisionId) && isValidDisciplinaryDecision(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt;
      allow delete: if hasRole('disciplinary_committee');
    }

    function isValidObjection(data) {
      return data.keys().hasAll(['teamId', 'matchId', 'status', 'createdAt', 'updatedAt']) &&
             data.teamId is string && data.teamId.size() <= 50 &&
             data.matchId is string && data.matchId.size() <= 50 &&
             data.status is string && data.status in ["pending", "investigating", "accepted", "rejected"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
             (!('decision' in data) || (data.decision is string && data.decision.size() <= 2000));
    }

    match /objections/{objectionId} {
      allow read, list: if hasRole('disciplinary_committee') || isTeamManager(existing().teamId);
      allow create: if isTeamManager(incoming().teamId) && isValidId(objectionId) && isValidObjection(incoming()) && incoming().status == 'pending' && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(objectionId) && isValidObjection(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().teamId == existing().teamId && (hasRole('disciplinary_committee') || (isTeamManager(existing().teamId) && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'details', 'updatedAt'])));
      allow delete: if hasRole('disciplinary_committee') || (isTeamManager(existing().teamId) && existing().status == 'pending');
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('issuer' in data) || (data.issuer is string && data.issuer.size() <= 100));
    }

    match /announcements/{announcementId} {
      allow read, list: if true;
      allow create: if hasRole('media_manager') && isValidId(announcementId) && isValidAnnouncement(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if hasRole('media_manager') && isValidId(announcementId) && isValidAnnouncement(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt;
      allow delete: if hasRole('media_manager');
    }

    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500));
    }

    match /news/{newsId} {
      allow read, list: if true;
      allow create: if hasRole('media_manager') && isValidId(newsId) && isValidNews(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if hasRole('media_manager') && isValidId(newsId) && isValidNews(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt;
      allow delete: if hasRole('media_manager');
    }

    function isValidStadium(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('capacity' in data) || data.capacity is number) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500));
    }

    match /stadiums/{stadiumId} {
      allow read, list: if true;
      allow create: if hasRole('tournament_manager') && isValidId(stadiumId) && isValidStadium(incoming()) && incoming().createdAt == request.time;
      allow update: if hasRole('tournament_manager') && isValidId(stadiumId) && isValidStadium(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if hasRole('tournament_manager');
    }

    function isValidReferee(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500));
    }

    match /referees/{refereeId} {
      allow read, list: if true;
      allow create: if hasRole('tournament_manager') && isValidId(refereeId) && isValidReferee(incoming()) && incoming().createdAt == request.time;
      allow update: if hasRole('tournament_manager') && isValidId(refereeId) && isValidReferee(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if hasRole('tournament_manager');
    }
  }
}
