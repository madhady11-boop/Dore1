rules_version = '2';

// قواعد تخزين الصور — دوري صوب الشامية
// انسخ هذا الملف والصقه في: Firebase Console ← Storage ← Rules ← Publish
// يسمح بقراءة الصور للجميع، وبالرفع للحسابات المسجّلة فقط، بحد أقصى 5MB وللصور فقط.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
